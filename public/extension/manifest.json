
{
  "manifest_version": 3,
  "name": "Next Video Player - Side Panel",
  "version": "1.0",
  "description": "Open Next Video Player in your Chrome Side Panel.",
  "permissions": ["sidePanel"],
  "action": {
    "default_title": "Open Side Panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  }
}
